nextflow.enable.dsl = 2

/*
 * Lesson 3 connects two processes.
 *
 * The output of the first process becomes the input of the second.
 */

process CREATE_CASE_REPORT {
    tag "U13824"

    input:
    path context_file

    output:
    path "upec_case_report.txt", emit: report

    script:
    """
    echo "UPEC Teaching Case" > upec_case_report.txt
    echo "==================" >> upec_case_report.txt
    cat ${context_file} >> upec_case_report.txt
    """
}

process ADD_REPRODUCIBILITY_NOTE {
    tag "final report"

    input:
    path case_report

    output:
    path "upec_final_report.txt"

    script:
    """
    cat ${case_report} > upec_final_report.txt
    echo "" >> upec_final_report.txt
    echo "Reproducibility note:" >> upec_final_report.txt
    echo "This report was generated by a two-process Nextflow workflow." \
        >> upec_final_report.txt
    """
}

workflow {
    context_ch = Channel.fromPath(
        "${projectDir}/upec_context.txt",
        checkIfExists: true
    )

    CREATE_CASE_REPORT(context_ch)

    ADD_REPRODUCIBILITY_NOTE(
        CREATE_CASE_REPORT.out.report
    )
}
